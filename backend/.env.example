# Environment
# En production, définir NODE_ENV=production dans l'environnement de déploiement.
NODE_ENV=development

# Server
PORT=5000

# Database
MONGO_URI=mongodb://localhost:27017/radio

# JWT (minimum 32 characters)
JWT_SECRET=your_jwt_secret_minimum_32_characters_here
JWT_EXPIRE=7d

# Admin maintenance scripts
# Utiliser uniquement des mots de passe forts et ne jamais committer le vrai .env.
ADMIN_EMAIL=roots@radio.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_With_A_Strong_Admin_Password_123
CREATE_TEST_USERS=false
TEST_USER_PASSWORD=change_me_With_A_Strong_Test_Password_123

# Seed script
SEED_ADMIN_PASSWORD=change_me_With_A_Strong_Seed_Admin_123
SEED_EDITOR_PASSWORD=change_me_With_A_Strong_Seed_Editor_123
SEED_USER_PASSWORD=change_me_With_A_Strong_Seed_User_123

# CORS
CORS_ORIGIN=http://localhost:3000

# Frontend
FRONTEND_URL=http://localhost:3000

# Live Stream
LIVE_STREAM_URL=http://ecmanager2.pro-fhi.net:1510/stream
STREAM_URL=http://ecmanager2.pro-fhi.net:1510/stream

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
USE_S3=false

# Auto cleanup
AUTO_CLEAN_HISTORY=false
